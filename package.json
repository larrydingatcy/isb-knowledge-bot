{
  "name": "isb-knowledge-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "pnpm build:index && pnpm --filter @isb/web build",
    "build:index": "tsx scripts/build-index.ts",
    "e2e": "playwright test",
    "ingest": "tsx scripts/ingest.ts",
    "dragons-gate": "tsx scripts/dragons-gate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@vercel/node": "^23.0.1",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@isb/answering": "workspace:*",
    "@isb/api-core": "workspace:*",
    "@isb/knowledge": "workspace:*",
    "robots-parser": "^3.0.1"
  }
}
